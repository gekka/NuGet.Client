<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <UsingToolXliff>false</UsingToolXliff>
  </PropertyGroup>
  <!-- Empty target for Xliff update -->
  <Target Name="UpdateXlf" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)\TestCultureModule.cs" Link="TestCultureModule.cs" />
  </ItemGroup>
</Project>
